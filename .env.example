# Скопируйте в .env.local (локально) или .env (для docker compose)
# OpenRouter — обязателен
OPENROUTER_API_KEY=sk-or-...

# Модели (опционально; иначе из страницы Настройки)
O3_MODEL=openai/o3-mini
TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo

# Вход через Яндекс ID (опционально)
APP_URL=http://localhost:3000
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Админ-панель (/admin) — по умолчанию admin / Tutor#Admin-2026
ADMIN_LOGIN=admin
ADMIN_PASSWORD=Tutor#Admin-2026
ADMIN_SECRET=tutor-admin-secret-change-me

# Только для docker compose (в .env со стороны сервера), НЕ для локального .env.local:
TUTOR_DB_PATH=/app/data/tutor.db
