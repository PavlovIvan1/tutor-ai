# Скопируйте в .env.local (локально) или .env (для docker compose) и заполните своими значениями.

# --- AI-провайдер: Polza.ai (основной) ---
POLZA_API_KEY=
# Модели по умолчанию (можно менять из админки / настроек пользователя)
TRANSCRIBE_MODEL=openai/whisper-large-v3-turbo
O3_MODEL=openai/gpt-4o-mini
# Генерация картинок для заданий
AI_IMAGE_MODEL=x-ai/grok-imagine-image

# --- Fallback на OpenRouter (только если POLZA_API_KEY пустой) ---
OPENROUTER_API_KEY=

# Вход через Яндекс ID (опционально)
APP_URL=http://localhost:3000
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=

# Админ-панель (/admin) — обязательны на проде
ADMIN_LOGIN=
ADMIN_PASSWORD=
ADMIN_SECRET=

# Необязательно: явный путь к БД (по умолчанию ./data/tutor.db, в docker — /app/data/tutor.db)
# TUTOR_DB_PATH=/app/data/tutor.db
